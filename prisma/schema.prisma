generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    BigInt                  @id @default(autoincrement())
  name                  String                  @db.VarChar(100)
  owner_name            String?                 @db.VarChar(100)
  phone                 String                  @db.VarChar(15)
  email                 String?                 @db.VarChar(100)
  gst_number            String?                 @db.VarChar(20)
  status                tenants_status?         @default(ACTIVE)
  created_at            DateTime?               @default(now()) @db.DateTime(0)
  updated_at            DateTime?               @default(now()) @db.DateTime(0)
  activity_logs         activity_logs[]
  categories            categories[]
  customer_ledger       customer_ledger[]
  customers             Customer[]
  import_jobs           import_jobs[]
  inventory             Inventory[]
  invoices              Invoice[]
  payments              Payment[]
  product_barcodes      product_barcodes[]
  product_variants      product_variants[]
  products              Product[]
  supplier_bank_details supplier_bank_details[]
  users                 User[]

  @@map("tenants")
}

model User {
  id            BigInt          @id @default(autoincrement())
  tenant_id     BigInt
  name          String?         @db.VarChar(100)
  phone         String?         @db.VarChar(15)
  email         String?         @db.VarChar(100)
  password_hash String?         @db.VarChar(255)
  is_active     Boolean?        @default(true)
  created_at    DateTime?       @default(now()) @db.DateTime(0)
  activity_logs activity_logs[]
  user_roles    user_roles[]
  tenants       Tenant          @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "users_ibfk_1")

  @@index([tenant_id], map: "tenant_id")
  @@map("users")
}

model Customer {
  id              BigInt                   @id @default(autoincrement())
  tenant_id       BigInt
  name            String?                  @db.VarChar(100)
  phone           String?                  @db.VarChar(15)
  email           String?                  @db.VarChar(100)
  password_hash   String?                  @db.VarChar(255)
  auth_provider   customers_auth_provider? @default(PASSWORD)
  last_login_at   DateTime?                @db.DateTime(0)
  credit_balance  Decimal?                 @default(0.00) @db.Decimal(10, 2)
  created_at      DateTime?                @default(now()) @db.DateTime(0)
  is_active       Boolean?                 @default(true)
  version         Int                      @default(0)
  customer_ledger customer_ledger[]
  tenants         Tenant                   @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "customers_ibfk_1")
  invoices        Invoice[]
  payments        Payment[]

  @@unique([tenant_id, phone], map: "idx_customer_phone_tenant")
  @@index([tenant_id], map: "idx_customer_tenant")
  @@map("customers")
}

model Product {
  id                     BigInt                   @id @default(autoincrement())
  tenant_id              BigInt
  category_id            BigInt?
  product_master_id      BigInt?
  name                   String?                  @db.VarChar(150)
  image_url              String?                  @db.VarChar(255)
  is_active              Boolean                  @default(true)
  product_variants       product_variants[]
  product_master         product_master?          @relation(fields: [product_master_id], references: [id], onUpdate: NoAction, map: "fk_products_product_master")
  tenants                Tenant                   @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "products_ibfk_1")
  categories             categories?              @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "products_ibfk_2")
  purchase_invoice_items purchase_invoice_items[]

  @@index([category_id], map: "category_id")
  @@index([tenant_id, is_active], map: "idx_products_active")
  @@index([product_master_id], map: "idx_products_product_master")
  @@map("products")
}

model Inventory {
  variant_id          BigInt           @id
  tenant_id           BigInt
  quantity            Int?             @default(0)
  low_stock_threshold Int?             @default(5)
  version             Int              @default(0)
  product_variants    product_variants @relation(fields: [variant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "inventory_ibfk_1")
  tenants             Tenant           @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "inventory_ibfk_2")

  @@index([tenant_id], map: "tenant_id")
  @@map("inventory")
}

model Invoice {
  id               BigInt             @id @default(autoincrement())
  tenant_id        BigInt
  customer_id      BigInt?
  order_id         BigInt?
  invoice_number   String?            @unique(map: "invoice_number") @db.VarChar(50)
  total_amount     Decimal?           @db.Decimal(10, 2)
  gst_amount       Decimal?           @db.Decimal(10, 2)
  status           invoices_status?   @default(DRAFT)
  invoice_url      String?            @db.VarChar(255)
  created_at       DateTime?          @default(now()) @db.DateTime(0)
  idempotency_key  String?            @db.VarChar(64)
  subtotal_amount  Decimal?           @db.Decimal(12, 2)
  discount_amount  Decimal?           @default(0.00) @db.Decimal(12, 2)
  paid_amount      Decimal?           @default(0.00) @db.Decimal(12, 2)
  finalized_at     DateTime?          @db.DateTime(0)
  cancelled_at     DateTime?          @db.DateTime(0)
  invoice_items    InvoiceItem[]
  invoice_payments invoice_payments[]
  tenants          Tenant             @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "invoices_ibfk_1")
  customers        Customer?          @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "invoices_ibfk_2")
  payments         Payment[]

  @@unique([tenant_id, idempotency_key], map: "uq_invoice_idempotency")
  @@index([customer_id], map: "customer_id")
  @@index([created_at], map: "idx_invoice_date")
  @@index([tenant_id], map: "idx_invoice_tenant")
  @@index([order_id], map: "idx_invoice_order")
  @@map("invoices")
}

model InvoiceItem {
  id               BigInt            @id @default(autoincrement())
  invoice_id       BigInt?
  variant_id       BigInt?
  quantity         Int?
  price            Decimal?          @db.Decimal(10, 2)
  unit_price       Decimal           @db.Decimal(10, 2)
  discount_amount  Decimal?          @default(0.00) @db.Decimal(10, 2)
  final_price      Decimal           @db.Decimal(10, 2)
  invoices         Invoice?          @relation(fields: [invoice_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "invoice_items_ibfk_1")
  product_variants product_variants? @relation(fields: [variant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "invoice_items_ibfk_2")

  @@index([invoice_id], map: "invoice_id")
  @@index([variant_id], map: "variant_id")
  @@map("invoice_items")
}

model Payment {
  id               BigInt                 @id @default(autoincrement())
  tenant_id        BigInt
  customer_id      BigInt
  invoice_id       BigInt?
  amount           Decimal                @db.Decimal(10, 2)
  payment_mode     payments_payment_mode?
  reference_note   String?                @db.VarChar(255)
  created_at       DateTime?              @default(now()) @db.DateTime(0)
  idempotency_key  String?                @db.VarChar(64)
  applied_amount   Decimal?               @db.Decimal(10, 2)
  invoice_payments invoice_payments[]
  tenants          Tenant                 @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "payments_ibfk_1")
  customers        Customer               @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "payments_ibfk_2")
  invoices         Invoice?               @relation(fields: [invoice_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "payments_ibfk_3")

  @@unique([tenant_id, idempotency_key], map: "uq_payment_idempotency")
  @@index([customer_id], map: "customer_id")
  @@index([created_at], map: "idx_payment_date")
  @@index([invoice_id], map: "invoice_id")
  @@index([tenant_id], map: "tenant_id")
  @@map("payments")
}

model activity_logs {
  id          BigInt    @id @default(autoincrement())
  tenant_id   BigInt
  user_id     BigInt
  action      String    @db.VarChar(50)
  entity_type String    @db.VarChar(50)
  entity_id   BigInt
  old_value   Json?
  new_value   Json?
  ip_address  String?   @db.VarChar(45)
  user_agent  String?   @db.VarChar(255)
  created_at  DateTime? @default(now()) @db.DateTime(0)
  tenants     Tenant    @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "activity_logs_ibfk_1")
  users       User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "activity_logs_ibfk_2")

  @@index([entity_type, entity_id], map: "idx_entity")
  @@index([tenant_id, created_at], map: "idx_tenant_date")
  @@index([user_id], map: "user_id")
}

model categories {
  id        BigInt    @id @default(autoincrement())
  tenant_id BigInt
  name      String?   @db.VarChar(100)
  is_active Boolean   @default(true)
  tenants   Tenant    @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "categories_ibfk_1")
  products  Product[]

  @@index([tenant_id, is_active], map: "idx_categories_active")
}

model customer_ledger {
  id           BigInt                      @id @default(autoincrement())
  tenant_id    BigInt
  customer_id  BigInt
  entry_type   customer_ledger_entry_type?
  reference_id BigInt?
  description  String?                     @db.VarChar(255)
  amount       Decimal                     @db.Decimal(10, 2)
  created_at   DateTime?                   @default(now()) @db.DateTime(0)
  created_by   BigInt?
  tenants      Tenant                      @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "customer_ledger_ibfk_1")
  customers    Customer                    @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "customer_ledger_ibfk_2")

  @@index([customer_id], map: "customer_id")
  @@index([tenant_id, customer_id], map: "idx_ledger_customer")
  @@index([created_at], map: "idx_ledger_date")
}

model import_job_rows {
  id            BigInt                  @id @default(autoincrement())
  import_job_id BigInt
  row_no        Int
  raw_data      Json
  status        import_job_rows_status? @default(PENDING)
  error_message String?                 @db.Text
  created_at    DateTime?               @default(now()) @db.DateTime(0)
  import_jobs   import_jobs             @relation(fields: [import_job_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "import_job_rows_ibfk_1")

  @@index([import_job_id, status], map: "idx_import_job_status")
  @@index([import_job_id, status], map: "idx_job_status")
}

model import_jobs {
  id              BigInt              @id @default(autoincrement())
  tenant_id       BigInt
  type            import_jobs_type?
  status          import_jobs_status?
  file_url        String?             @db.VarChar(255)
  created_at      DateTime?           @default(now()) @db.DateTime(0)
  file_key        String?             @db.VarChar(255)
  file_size       BigInt?
  file_mime       String?             @db.VarChar(100)
  import_job_rows import_job_rows[]
  tenants         Tenant              @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "import_jobs_ibfk_1")

  @@index([tenant_id], map: "tenant_id")
}

model permissions {
  id               BigInt             @id @default(autoincrement())
  code             String             @unique(map: "code") @db.VarChar(100)
  description      String?            @db.VarChar(255)
  role_permissions role_permissions[]
}

model product_variants {
  id                     BigInt                      @id @default(autoincrement())
  tenant_id              BigInt
  product_id             BigInt
  brand                  String?                     @db.VarChar(100)
  size                   String?                     @db.VarChar(50)
  packaging              product_variants_packaging?
  price                  Decimal?                    @db.Decimal(10, 2)
  gst_percent            Decimal?                    @db.Decimal(5, 2)
  sku                    String?                     @db.VarChar(50)
  image_url              String?                     @db.VarChar(255)
  is_active              Boolean?                    @default(true)
  mrp_price              Decimal?                    @db.Decimal(10, 2)
  selling_price          Decimal?                    @db.Decimal(10, 2)
  inventory              Inventory?
  invoice_items          InvoiceItem[]
  product_barcodes       product_barcodes[]
  tenants                Tenant                      @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "product_variants_ibfk_1")
  products               Product                     @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "product_variants_ibfk_2")
  purchase_invoice_items purchase_invoice_items[]

  @@unique([tenant_id, sku], map: "idx_variant_sku_tenant")
  @@index([tenant_id], map: "idx_variant_tenant")
  @@index([product_id], map: "product_id")
}

model role_permissions {
  role          role_permissions_role
  permission_id BigInt
  permissions   permissions           @relation(fields: [permission_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "role_permissions_ibfk_1")

  @@id([role, permission_id])
  @@index([permission_id], map: "permission_id")
}

model roles {
  id         BigInt       @id @default(autoincrement())
  name       roles_name?  @unique(map: "name")
  user_roles user_roles[]
}

model system_jobs {
  id            BigInt              @id @default(autoincrement())
  tenant_id     BigInt?
  type          String?             @db.VarChar(50)
  status        system_jobs_status?
  error_message String?             @db.Text
  created_at    DateTime?           @default(now()) @db.DateTime(0)
}

model user_roles {
  user_id BigInt
  role_id BigInt
  users   User   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_roles_ibfk_1")
  roles   roles  @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_roles_ibfk_2")

  @@id([user_id, role_id])
  @@index([role_id], map: "role_id")
}

model purchase_invoice_items {
  id                  BigInt            @id @default(autoincrement())
  purchase_invoice_id BigInt
  product_id          BigInt
  variant_id          BigInt?
  quantity            Decimal           @db.Decimal(10, 2)
  purchase_price      Decimal           @db.Decimal(10, 2)
  created_at          DateTime?         @default(now()) @db.DateTime(0)
  purchase_invoices   purchase_invoices @relation(fields: [purchase_invoice_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "purchase_invoice_items_ibfk_1")
  products            Product           @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "purchase_invoice_items_product_fk")
  product_variants    product_variants? @relation(fields: [variant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "purchase_invoice_items_variant_fk")

  @@index([purchase_invoice_id], map: "purchase_invoice_id")
  @@index([product_id], map: "product_id_idx")
  @@index([variant_id], map: "variant_id_idx")
}

model purchase_invoices {
  id                     BigInt                    @id @default(autoincrement())
  tenant_id              BigInt
  supplier_id            BigInt
  invoice_number         String?                   @db.VarChar(100)
  invoice_date           DateTime                  @db.Date
  total_amount           Decimal                   @db.Decimal(12, 2)
  paid_amount            Decimal?                  @default(0.00) @db.Decimal(12, 2)
  status                 purchase_invoices_status? @default(UNPAID)
  created_at             DateTime?                 @default(now()) @db.DateTime(0)
  purchase_invoice_items purchase_invoice_items[]
  suppliers              suppliers                 @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "purchase_invoices_ibfk_1")

  @@index([supplier_id], map: "idx_purchase_supplier")
}

model supplier_ledger {
  id           BigInt                   @id @default(autoincrement())
  tenant_id    BigInt
  supplier_id  BigInt
  ref_type     supplier_ledger_ref_type
  ref_id       BigInt?
  credit       Decimal?                 @default(0.00) @db.Decimal(12, 2)
  debit        Decimal?                 @default(0.00) @db.Decimal(12, 2)
  balance      Decimal                  @db.Decimal(12, 2)
  created_at   DateTime?                @default(now()) @db.DateTime(0)
  description  String?                  @db.Text
  payment_mode String?                  @db.VarChar(20)

  @@index([supplier_id, created_at], map: "idx_supplier_ledger")
}

model suppliers {
  id                    BigInt                  @id @default(autoincrement())
  tenant_id             BigInt
  name                  String                  @db.VarChar(255)
  phone                 String?                 @db.VarChar(20)
  email                 String?                 @db.VarChar(255)
  address               String?                 @db.Text
  is_active             Boolean?                @default(true)
  created_at            DateTime?               @default(now()) @db.DateTime(0)
  purchase_invoices     purchase_invoices[]
  supplier_bank_details supplier_bank_details[]

  @@unique([tenant_id, phone], map: "tenant_id")
  @@index([tenant_id], map: "idx_supplier_tenant")
}

model invoice_payments {
  id         BigInt    @id @default(autoincrement())
  tenant_id  BigInt
  invoice_id BigInt
  payment_id BigInt
  amount     Decimal   @db.Decimal(12, 2)
  created_at DateTime? @default(now()) @db.DateTime(0)
  invoices   Invoice   @relation(fields: [invoice_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "invoice_payments_ibfk_1")
  payments   Payment   @relation(fields: [payment_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "invoice_payments_ibfk_2")

  @@unique([invoice_id, payment_id], map: "uq_invoice_payment")
  @@index([payment_id], map: "payment_id")
}

model cart_items {
  id                     BigInt  @id @default(autoincrement())
  cart_id                BigInt
  variant_id             BigInt
  quantity               Int
  selling_price_snapshot Decimal @db.Decimal(10, 2)

  @@index([cart_id], map: "idx_cart_items_cart")
}

model carts {
  id          BigInt        @id @default(autoincrement())
  tenant_id   BigInt
  customer_id BigInt
  status      carts_status? @default(ACTIVE)
  created_at  DateTime?     @default(now()) @db.DateTime(0)

  @@index([customer_id], map: "idx_cart_customer")
}

model order_items {
  id          BigInt  @id @default(autoincrement())
  order_id    BigInt
  product_id  BigInt
  variant_id  BigInt
  quantity    Int
  unit_price  Decimal @db.Decimal(10, 2)
  total_price Decimal @db.Decimal(12, 2)

  @@index([order_id], map: "idx_order_items_order")
  @@index([variant_id], map: "idx_order_items_variant")
}

model orders {
  id           BigInt         @id @default(autoincrement())
  tenant_id    BigInt
  customer_id  BigInt
  status       orders_status? @default(PLACED)
  total_amount Decimal        @db.Decimal(12, 2)
  source       orders_source? @default(CUSTOMER_APP)
  created_at   DateTime?      @default(now()) @db.DateTime(0)
  updated_at   DateTime?      @default(now()) @db.DateTime(0)

  @@index([customer_id], map: "idx_order_customer")
  @@index([tenant_id], map: "idx_order_tenant")
}

model payment_intents {
  id             BigInt               @id @default(autoincrement())
  tenant_id      BigInt
  order_id       BigInt
  mode           payment_intents_mode
  reference_note String?              @db.VarChar(255)
  created_at     DateTime?            @default(now()) @db.DateTime(0)

  @@index([order_id], map: "idx_payment_intent_order")
}

model supplier_bank_details {
  id                  BigInt    @id @default(autoincrement())
  tenant_id           BigInt
  supplier_id         BigInt
  account_holder_name String    @db.VarChar(150)
  bank_name           String    @db.VarChar(150)
  account_number      String    @db.VarChar(50)
  ifsc_code           String    @db.VarChar(20)
  branch_name         String?   @db.VarChar(150)
  account_type        String?   @db.VarChar(20)
  is_primary          Boolean?  @default(true)
  is_active           Boolean?  @default(true)
  created_at          DateTime? @default(now()) @db.DateTime(0)
  updated_at          DateTime? @default(now()) @db.DateTime(0)
  suppliers           suppliers @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "supplier_bank_supplier_fk")
  tenants             Tenant    @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "supplier_bank_tenant_fk")

  @@index([supplier_id], map: "idx_supplier_bank_supplier")
  @@index([tenant_id], map: "idx_supplier_bank_tenant")
}

model product_barcodes {
  id               BigInt           @id @default(autoincrement())
  tenant_id        BigInt
  variant_id       BigInt
  barcode          String           @db.VarChar(50)
  is_active        Boolean?         @default(true)
  created_at       DateTime?        @default(now()) @db.DateTime(0)
  tenants          Tenant           @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_barcode_tenant")
  product_variants product_variants @relation(fields: [variant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_barcode_variant")

  @@unique([tenant_id, barcode], map: "uq_tenant_barcode")
  @@index([barcode], map: "idx_barcode")
  @@index([variant_id], map: "idx_barcode_variant")
}

model product_master {
  id                BigInt    @id @default(autoincrement())
  name              String    @db.VarChar(255)
  brand             String?   @db.VarChar(150)
  category_name     String?   @db.VarChar(150)
  default_image_url String?   @db.VarChar(255)
  description       String?   @db.Text
  is_active         Boolean?  @default(true)
  created_at        DateTime? @default(now()) @db.DateTime(0)
  updated_at        DateTime? @default(now()) @db.DateTime(0)
  products          Product[]

  @@index([brand], map: "idx_product_master_brand")
  @@index([name], map: "idx_product_master_name")
}

enum role_permissions_role {
  OWNER
  MANAGER
  CASHIER
}

enum roles_name {
  OWNER
  MANAGER
  CASHIER
}

enum import_jobs_type {
  CUSTOMER
  PRODUCT
  INVENTORY
  CATEGORY
}

enum customer_ledger_entry_type {
  OPENING_BALANCE
  INVOICE
  PAYMENT
  ADJUSTMENT
}

enum import_jobs_status {
  PENDING
  PROCESSING
  VALIDATED
  FAILED
  COMPLETED
}

enum system_jobs_status {
  PENDING
  RUNNING
  FAILED
  COMPLETED
}

enum import_job_rows_status {
  PENDING
  VALID
  INVALID
  IMPORTED
}

enum payments_payment_mode {
  CASH
  UPI
  CARD
  BANK
  ADJUSTMENT
}

enum product_variants_packaging {
  POUCH
  BOTTLE
  CAN
  BOX
}

enum tenants_status {
  ACTIVE
  SUSPENDED
}

enum supplier_ledger_ref_type {
  OPENING
  PURCHASE
  PAYMENT
}

enum purchase_invoices_status {
  UNPAID
  PARTIAL
  PAID
}

enum invoices_status {
  DRAFT
  FINALIZED
  UNPAID
  PARTIAL
  PAID
  CANCELLED
}

enum carts_status {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum orders_status {
  PLACED
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

